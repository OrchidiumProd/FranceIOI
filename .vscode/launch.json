{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Lancer le C++ ouvert",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${config:cpp.binPath};${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${config:cpp.gdbPath}",
            "preLaunchTask": "Compiler le fichier C++"
        }
    ]
}
