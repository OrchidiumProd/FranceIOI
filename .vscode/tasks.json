{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compiler le fichier C++",
            "type": "process",
            "command": "${config:cpp.compilerPath}",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Executer le fichier C++",
            "type": "process",
            "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "dependsOn": "Compiler le fichier C++",
            "options": {
                "env": {
                    "PATH": "${config:cpp.binPath};${env:PATH}"
                }
            },
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
